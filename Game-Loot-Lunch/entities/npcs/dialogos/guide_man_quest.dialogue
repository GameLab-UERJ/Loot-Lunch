elif QuestManager.current_status == QuestManager.QuestStatus.FAZER_REFEICAO_FINAL:
	if GlobalData._find_inventory().has_item("Farofa de Tanajura com Carne"):
		Carlos - O Guia: ...
		Carlos - O Guia: ...
		Carlos - O Guia: Você é uma benção...
		Carlos - O Guia: Por favor, leve o restante para Julieta.
		Carlos - O Guia: Ela passa todo tempo dela em uma cela nas Masmorras.
